# RwandaBus Smart Bus Tracking System - Environment Configuration

# Supabase Credentials (Optional for local demo mode; Required for live cloud deployment)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Country & Regional Defaults
VITE_DEFAULT_COUNTRY=Rwanda
VITE_DEFAULT_CITY=Kigali
VITE_DEFAULT_TIMEZONE=Africa/Kigali
VITE_CURRENCY=RWF
VITE_CALLING_CODE=+250

# Map Tile Configuration
# Default uses OpenStreetMap standard tiles
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
